{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "labels": ["renovate", "dependencies"],
  "packageRules": [
    {
      "description": "Auto-merge patch updates for all dependencies",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Auto-merge minor updates for non-database packages",
      "matchUpdateTypes": ["minor"],
      "matchPackagePatterns": ["^(?!postgres|mysql|mariadb|redis).*$"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Manual approval for PostgreSQL major version changes",
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["database", "manual-review"]
    },
    {
      "description": "Manual approval for any major version change",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["major-update", "manual-review"]
    }
  ],
  "docker-compose": {
    "enabled": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "schedule": ["before 6am on monday"],
  "timezone": "Asia/Shanghai",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 4
}
